{
  "name": "gestao-escolar-api",
  "version": "0.1.0",
  "description": "API do Sistema de Gestão Escolar (Angola)",
  "scripts": {
    "dev": "node --watch --env-file=.env src/servidor.js",
    "start": "node src/servidor.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "vitest run",
    "migrar": "node --env-file=.env scripts/migrar.js",
